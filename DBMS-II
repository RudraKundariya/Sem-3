set @b=10;

if(@a>@b)
	print concat(@a,' ','is maximum')
else
	print concat(@b,' ','is maximum')

-- 3 Write a T - SQL block to �nd the maximum number from the given three numbers--

declare @d int,@e int,@c int

set @c=10;
set @d=1;
set @e=96;

if(@c>@d and @c>@e)
	print concat(@c,' ','is maximum')
else if(@e>@d and @e>@c)
	print concat(@e,' ','is maximum')
else
	print concat(@d,' ','is maximum')

