create database rudra_1092
use rudra_1092

create table bank_master
(bank_id int primary key,
bank_name varchar(30),
bank_shortname char(5)
)


create table branch_master
(branch_id int primary key,
branch_name varchar(30),
branch_ifsc int unique,
bank_id int foreign key references bank_master(bank_id))


create table employee_master
(emp_no int primary key,
branch_ifsc int foreign key references branch_master(branch_ifsc),
emp_fullname varchar(30),
emp_designation varchar(30),
emp_manager_no int,
emp_salary float,
)


create table customer_master
(cust_id int primary key,
cust_fullname varchar(30),
cust_dob date,
cust_address varchar(30),
cust_mobile_no varchar(40),
cust_emailid varchar(40),
cust_city varchar(40),
)


create table account_master
(acc_no int primary key,
cus_id int foreign key references customer_master(cust_id),
acc_type varchar(50) check(acc_type='sb'or acc_type='cr'),
branch_ifsc int foreign key references branch_master(branch_ifsc)
)

create table transation_master
(tran_id int primary key,
tran_acno int,
tran_date date,
tran_type varchar(30) check(tran_type='ch' or tran_type='cq' or tran_type='ol' or tran_type='rg'),
tran_amount_debit_card varchar(50) check(tran_amount_debit_card='d' or tran_amount_debit_card='c'),
tran_amount float
)


