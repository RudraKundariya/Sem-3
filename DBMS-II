Create FUNCTION FACT(@n int)
returns int
as
begin
	declare @ans int = 1;
	while(@n!=0)
	BEGIN
		set @ans = @ans *@n;
		set @n = @n-1;
	END
	return @ans;
end

SELECT dbo.FACT(5)

----5----

Create FUNCTION SUMOFODD (@s int , @e int)
returns int
as
begin
	declare @ans int = 0
	while(@e>@s)
	BEGIN
			if(@s%2!=0)
			begin 
				set @ans = @ans + @s
				set @s = @s + 2;
			end
			else
			begin
				set @s = @s + 1;
			end
	END
	return @ans
end

SELECT dbo.SUMOFODD(2,10)
