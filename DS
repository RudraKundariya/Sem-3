int push(int s[],int N,int X,int TOP)
{
	if(TOP>=N-1)
		printf("overflowing\n");
	else
	{
		TOP=TOP+1;
		s[TOP]=X;
	}
	return TOP;
}


int pop(int s[],int N,int TOP)
{
	if(TOP==-1)
		printf("underflowing\n");
	else
	{
		printf("%d is pop element\n",s[TOP] );
		TOP=TOP-1;
	}
	return TOP;
}

void display(int s[],int TOP)
{
	if(TOP==-1)
		printf("stack is empty\n");
	else
	{
		for(int i=TOP;i>=0;i--)
		{
			printf("%d\n",s[i] );
		}	
	}
}	


void peep(int s[],int Top,int Ele)
{
	if(Top-Ele+1<0)
	{
		printf("stack is empty\n");
	}
	else
	{
		printf("%d\n",s[Top-Ele+1] );
	}
}


void change(int s[],int Top,int Pos,int Val)
{
	if(Top-Pos+1>0)
	{
		printf("stack is empty\n");
	}
	else
	{
		s[Top-Pos+1]=Val;
	}
}


void avg(int s[],int TOP)
{
	float sum;
	int count=0;
	if(TOP==-1)
	{
		printf("stack is empty\n");
	}
	else
	{
		for(int i=TOP;i>=0;i--)
		{
		 sum=sum+s[i];
		 count++;
		}
		printf("avg is:%f\n",sum/count );
	}
}


void mm(int s[],int TOP)
{
	int max,min;
	max=min=s[TOP];
	if(TOP==-1)
		printf("stack is empty\n");
	else{
		for(int i=TOP-1;i>=0;i--)
		{
			if(max<i)
				max=s[i];
			if(min>i)
				min=s[i];
		}
	}
	printf("max=%d\nmin=%d\n",max,min );
}
