struct Node {
    int info;
    struct Node* link;
};

struct Node* create_node() {
    struct Node* new_node = (struct Node*) malloc(sizeof(struct Node));
    if (new_node == NULL) {
        printf("Memory allocation failed\n");
        exit(1);
    }
    return new_node;
}

int count(struct Node* first) {
    int c = 0;
    struct Node* ptr = first;
    while (ptr != NULL) {
        ptr = ptr->link;
        c++;
    }
    return c;
}

struct Node* insert_beginning(int x, struct Node* first) {
    struct Node* new_node = create_node();
    new_node->info = x;
    new_node->link = first;
    return new_node;
}

struct Node* insert_end(int x, struct Node* first) {
    struct Node* new_node = create_node();
    new_node->info = x;
    new_node->link = NULL;

    if (first == NULL) {
        return new_node;
    }

    struct Node* ptr = first;
    while (ptr->link != NULL) {
        ptr = ptr->link;
    }
    ptr->link = new_node;
    return first;
}

struct Node* insert_at_specific(int x, int pos, struct Node* first) {
    int n = count(first), i = 1;
    struct Node* new_node = create_node();
    new_node->info = x;

    if (pos <= 1) {
        new_node->link = first;
        return new_node;
    } else if (pos > n + 1) {
        printf("Position out of bounds\n");
        free(new_node);
        return first;
    }

    struct Node* ptr = first;
    while (i < pos - 1) {
        ptr = ptr->link;
        i++;
    }

    new_node->link = ptr->link;
    ptr->link = new_node;

    return first;
}

struct Node* insert_at_value_after(int x, int value_at, struct Node* first) {
    struct Node* ptr = first;
    struct Node* new_node = create_node();
    new_node->info = x;

    while (ptr != NULL && ptr->info != value_at) {
        ptr = ptr->link;
    }

    if (ptr == NULL) {
        printf("Value not found\n");
        free(new_node);
    } else {
        new_node->link = ptr->link;
        ptr->link = new_node;
    }

    return first;
}

struct Node* insert_at_value_before(int x, int value_at, struct Node* first) {
    struct Node* new_node = create_node();
    new_node->info = x;

    if (first == NULL) {
        printf("Linked list is empty\n");
        free(new_node);
        return first;
    }

    if (first->info == value_at) {
        new_node->link = first;
        return new_node;
    }

    struct Node *ptr = first, *preptr = NULL;
    while (ptr != NULL && ptr->info != value_at) {
        preptr = ptr;
        ptr = ptr->link;
    }

    if (ptr == NULL) {
        printf("Value not found\n");
        free(new_node);
    } else {
        preptr->link = new_node;
        new_node->link = ptr;
    }

    return first;
}

struct Node* delete_beg(struct Node* first) {
    if (first == NULL) {
        printf("Linked list is empty\n");
        return first;
    }

    struct Node* ptr = first;
    first = first->link;
    free(ptr);
    return first;
}

struct Node* delete_end(struct Node* first) {
    if (first == NULL) {
        printf("Linked list is empty\n");
        return first;
    }

    if (first->link == NULL) {
        free(first);
        return NULL;
    }

    struct Node* ptr = first;
    while (ptr->link->link != NULL) {
        ptr = ptr->link;
    }

    free(ptr->link);
    ptr->link = NULL;
    return first;
}

struct Node* delete_specific(int pos, struct Node* first) {
    int n = count(first);
    if (first == NULL || pos < 1 || pos > n) {
        printf("Invalid position\n");
        return first;
    }

    if (pos == 1) {
        struct Node* temp = first;
        first = first->link;
        free(temp);
    } else {
        struct Node *ptr = first, *preptr = NULL;
        int i = 1;
        while (i < pos) {
            preptr = ptr;
            ptr = ptr->link;
            i++;
        }
        preptr->link = ptr->link;
        free(ptr);
    }
    return first;
}

void search(struct Node* first, int x) {
    if (first == NULL) {
        printf("Linked list is empty\n");
        return;
    }

    struct Node* ptr = first;
    int pos = 1, found = 0;

    while (ptr != NULL) {
        if (ptr->info == x) {
            printf("Value %d found at position %d\n", x, pos);
            found = 1;
            break;
        }
        ptr = ptr->link;
        pos++;
    }

    if (!found)
        printf("Value not found\n");
}

void display(struct Node* first) {
    if (first == NULL) {
        printf("Linked list is empty\n");
        return;
    }

    struct Node* ptr = first;
    while (ptr != NULL) {
        printf("%d -> ", ptr->info);
        ptr = ptr->link;
    }
    printf("NULL\n");
}

